{
  "v": 1,
  "weight": "light",
  "chain": [
    "claude-cli",
    "anthropic-api"
  ],
  "tools": [
    "read",
    "search",
    "run"
  ],
  "run_classes": [
    "build",
    "test"
  ],
  "guard": [
    "R1"
  ],
  "limits": {
    "wall_min": 60,
    "idle_min": 10,
    "retries": 2
  },
  "skills": {
    "allow": [
      "standards-*"
    ],
    "always": []
  },
  "slots": {
    "required": [
      "repo_profile",
      "group",
      "tasks"
    ],
    "optional": [
      "repo_context",
      "standards",
      "diff",
      "checks",
      "baseline"
    ]
  },
  "result": {
    "$id": "komodo:agent/tester/result/1",
    "type": "object",
    "required": [
      "items",
      "tasks"
    ]
  },
  "pool_slot": true
}
