{
  "v": 1,
  "weight": "heavy",
  "chain": [
    "claude-cli",
    "anthropic-api"
  ],
  "tools": [
    "read",
    "search",
    "lint_backlog"
  ],
  "run_classes": [],
  "guard": [],
  "limits": {
    "wall_min": 60,
    "idle_min": 10,
    "retries": 2
  },
  "skills": {
    "allow": [],
    "always": []
  },
  "slots": {
    "required": [
      "repo_profile",
      "repo_map",
      "layout",
      "goal"
    ],
    "optional": [
      "repo_context",
      "specs",
      "backlog"
    ]
  },
  "result": {
    "$id": "komodo:agent/planner/result/1",
    "additionalProperties": false,
    "properties": {
      "files": {
        "description": "Every task-list file of the plan, as an array of objects, never a string.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "description": "The whole file as text, front matter included.",
              "type": "string"
            },
            "path": {
              "description": "File path under docs/backlog/, such as epic-2/tg-2.1/TG.md.",
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "files"
    ],
    "type": "object"
  },
  "pool_slot": false
}
